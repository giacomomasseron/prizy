{
	admin off
	email {$ACME_EMAIL:admin@localhost}

	# No `auto_https` directive here on purpose: its argument must be one of
	# off/disable_redirects/disable_certs/ignore_loaded_certs — "on" is not a
	# legal value (`caddy validate` rejects it), because fully-on IS the
	# default and is spelled by omitting the directive, not by naming it.
	# Test-vs-production mode is switched by {$CADDY_SITE_ADDRESS:https://}
	# below instead: an explicit `:80` address makes Caddy log "listening
	# only on the HTTP port, so no automatic HTTPS will be applied" and skip
	# TLS entirely, which is exactly the plain-HTTP behaviour the test stack
	# needs, with no separate toggle required.

	# Before issuing a certificate for a hostname, ask the application whether
	# it is a real workspace. Without this, on-demand TLS issues certificates
	# for any hostname anyone points at this box.
	on_demand_tls {
		ask http://127.0.0.1:2020/_caddy/ask
	}

	# Test-only: substitute Caddy's own internal CA (self-signed, no network
	# call) for real ACME issuance, but only for the space-separated hostnames
	# named here — `ask` above still gates every one of them, unchanged. This
	# is what lets scripts/test-prod-stack.sh prove on-demand TLS actually
	# activates, offline, in seconds. No real deploy ever sets this variable,
	# so the inert placeholder default (a hostname nothing ever requests)
	# means `local_certs` never applies in production.
	local_certs {$CADDY_LOCAL_CERTS_HOSTS:caddy-local-certs-test-only.invalid}
}

# The routing every site shares.
(app) {
	root * /var/www/html/public
	encode zstd gzip

	# `route` (not bare top-level `handle` blocks) because the Caddyfile
	# adapter re-sorts top-level `handle` blocks by path-matcher specificity,
	# not by the order they're written — with bare handles, `/build/*`
	# (longer literal prefix) was tried BEFORE the dotfile refusal below, so
	# `/build/.secret` fell through to file_server and was served. `route`
	# disables that re-sorting and runs these in exactly the order written.
	route {
		# nginx enforced client_max_body_size 25m; Caddy has no default body
		# limit and streams straight to fpm, so an unbounded (or slow-drip)
		# POST would occupy an fpm worker for its whole duration — with
		# pm.max_children=8 (docker/prod/fpm-pool.conf), eight of those is a
		# full outage. 26214400 = 25 * 1024 * 1024, the exact byte count of
		# post_max_size=25M in docker/prod/php.ini (PHP's ini shorthand is
		# binary, not decimal), so this refuses at the edge no later than PHP
		# itself would.
		request_body {
			max_size 26214400
		}

		# Never serve a dotfile: neither one directly under public/ (e.g. a
		# stray .env, .git, .DS_Store, editor swapfile) nor one nested under
		# a subdirectory such as /build/.secret. Must come before every other
		# handler that can reach file_server, including @build below.
		@dotfile path */.* /.*
		handle @dotfile {
			respond 404
		}

		# Reachable only on the internal :2020 listener below. Laravel's
		# router rtrims a trailing slash before matching, so without the
		# second form here `/_caddy/ask/` would fall through every handler
		# below and reach php_fastcgi, turning the gate into a public
		# hostname oracle. Match both forms.
		@caddy_ask path /_caddy/ask /_caddy/ask/
		handle @caddy_ask {
			respond 404
		}

		# Reverb's WebSocket and server API. Paths verified in the package
		# source: GET /app/{appKey} and /apps/{appId}/*. Nothing in this
		# application's routes is defined under either prefix.
		handle /app/* {
			reverse_proxy reverb:8080
		}
		handle /apps/* {
			reverse_proxy reverb:8080
		}

		# Content-hashed filenames: safe to cache hard, and they never collide.
		@build path /build/*
		handle @build {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			php_fastcgi app:9000
			file_server
		}
	}
}

# Internal only — never published, so nothing outside this container reaches it.
# This is what `ask` above talks to, and what the container healthcheck probes:
# both need plain HTTP, which the public site stops being once auto_https is on.
:2020 {
	root * /var/www/html/public
	route {
		# Same dotfile refusal as the public site (see (app) above), kept
		# ahead of @internal for consistency even though the whitelist below
		# already excludes any dotfile path — belt and suspenders on a
		# listener that talks to the same public/ root.
		@dotfile path */.* /.*
		handle @dotfile {
			respond 404
		}

		@internal path /_caddy/ask /health
		handle @internal {
			php_fastcgi app:9000
		}
		handle {
			respond 404
		}
	}
}

{$CADDY_SITE_ADDRESS:https://} {
	import app

	# Configuring on-demand issuance globally (above) only makes certificates
	# available; a site must still opt in with its own `tls` directive or it
	# holds none. Without this, every TLS handshake fails in production —
	# `:80` test mode is unaffected: Caddy logs "listening only on the HTTP
	# port, so no automatic HTTPS will be applied" and this directive is
	# inert, proven by `caddy validate` passing in both modes and a plain
	# `:80` run still answering HTTP with no TLS involved.
	tls {
		on_demand
	}
}
