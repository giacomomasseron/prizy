# Production environment for a self-hosted Prizy.
#
# P-4's installer generates the secrets and writes a real .env from this
# template. Every value marked GENERATED must be unique per installation —
# copying them from anywhere is a compromise, not a shortcut.
#
# Every GENERATED marker (and any other comment that documents a key) sits on
# its own line ABOVE that key, never inline on the same line. Compose's
# dotenv parser only strips an inline "# comment" when a value precedes it on
# that line; with an empty value (exactly the state every GENERATED key is in
# until the installer fills it), the comment text itself becomes the value —
# e.g. `docker compose config` would read POSTGRES_PASSWORD as the literal
# string `# GENERATED`, defeating both the `:?` required-variable guards in
# docker-compose.prod.yml and Postgres's own auth.

APP_NAME=Prizy
APP_ENV=production
# GENERATED: base64: + 32 random bytes
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_BASE_DOMAIN=example.com
# Where sign-up and "find your workspace" live. Unset, they live on
# APP_BASE_DOMAIN itself, which is what a self-hosted install wants. A public
# cloud whose bare domain is its marketing website sets its own host here.
#APP_SIGNUP_HOST=signup.example.com
# Leave false for a self-hosted install. Set true only when anyone on the
# internet may sign up: each new workspace then stays offline (its address
# serves no workspace) until its owner clicks the emailed link, and is
# deleted after 24 hours if they never do. It needs working mail, so never
# with --mail=log.
SIGNUP_REQUIRES_ACTIVATION=false

# The port the web service publishes. P-3 puts Caddy in front of this.
HTTP_PORT=80
# The edge publishes both ports: 443 serves traffic, 80 answers ACME's HTTP
# challenge and redirects. Caddy obtains a certificate per workspace hostname
# on first request, after asking the application whether that hostname is real
# (unless CLOUDFLARE_API_TOKEN below is set).
HTTPS_PORT=443
# REQUIRED: a real, deliverable contact address for the ACME account. Let's
# Encrypt sends expiry warnings here.
#
# This ships EMPTY on purpose, like every other must-edit key in this file.
# The `:?` guard on it in docker-compose.prod.yml rejects unset and empty
# alike, so an unedited copy of this template stops the deploy with a message
# naming this key. Do not satisfy that guard with a placeholder address:
# Let's Encrypt refuses @example.com and @localhost as account contacts, so a
# placeholder buys a stack that starts cleanly and then fails every single
# certificate request — the quiet failure the guard exists to prevent.
ACME_EMAIL=
# Optional, when Cloudflare runs APP_BASE_DOMAIN's DNS: one wildcard
# certificate for every workspace subdomain instead of one per workspace, so
# new workspaces wait for no certificate, Let's Encrypt's weekly limit stops
# mattering, and workspace names stay out of the public certificate logs.
# Caddy proves the wildcard by writing a DNS record with this token, at issue
# and at every renewal. Create an Account API Token with Zone > Zone > Read and
# Zone > DNS > Edit, for this zone only. Apply a change to it by re-running
# the installer (or `up -d --build`), which rebuilds the web image with or
# without Caddy's Cloudflare plugin. The base domain itself and custom domains
# still get their own certificates.
#
# Workspace subdomains then use only the wildcard: until it is issued, and for
# as long as Cloudflare refuses the token, they fail to connect. Check the
# deploy with `docker compose -f docker-compose.prod.yml logs web`, which
# should show "certificate obtained successfully" for *.APP_BASE_DOMAIN. A
# token that is not a Cloudflare token at all stops Caddy from starting.
#CLOUDFLARE_API_TOKEN=

# Database. POSTGRES_PASSWORD belongs to the bundled database's `prizy`
# superuser, which owns nothing the application touches; PRIZY_APP_DB_PASSWORD
# belongs to the role the app connects as, `prizy_app`, which is no superuser
# so that row-level security applies to it.
# GENERATED
POSTGRES_PASSWORD=
# GENERATED for the bundled database; the external role's password under the
# installer's --db-host.
PRIZY_APP_DB_PASSWORD=
DB_CONNECTION=pgsql
# `postgres` is the bundled database. The installer's --db-host (with
# --db-port, --db-name and --db-user) writes an external server here instead.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=prizy
DB_USERNAME=prizy_app
# prefer, the default, uses TLS whenever the server offers it. For an external
# server reached over the internet, require refuses to connect without it.
#DB_SSLMODE=require

# Cache, sessions and queues all run on Redis.
# GENERATED
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Sessions are deliberately scoped to the exact host. Setting SESSION_DOMAIN
# to a parent domain would share one cookie across every workspace subdomain
# and break the per-host tenant isolation the application relies on.
SESSION_LIFETIME=120

# Real-time is opt-in; without it the frontend polls, which is the
# application's own default. Enabling the server side means running the
# `realtime` compose profile (see docker-compose.prod.yml).
BROADCAST_CONNECTION=log
# GENERATED
REVERB_APP_ID=
# GENERATED
REVERB_APP_KEY=
# GENERATED
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Which sites' pages may open a socket: hostnames only (no scheme or port),
# `*` wildcards allowed. Unset, APP_BASE_DOMAIN and every workspace under it,
# which is all a subdomain install needs. A workspace served on its own
# custom domain gets real-time only once that domain is listed here, and
# setting this REPLACES the default, so keep the base domain entries:
#REVERB_ALLOWED_ORIGINS=example.com,*.example.com,support.acme.com

# Browser-side. Vite reads these at IMAGE BUILD TIME, not container start —
# and today this file's values never reach that build: .dockerignore is a
# strict allowlist with no .env entry, and Dockerfile.prod's `assets` stage
# declares no ARG/ENV for VITE_*, so nothing carries them in. Filling these
# in and rebuilding does NOT enable real-time; it fails silently, leaving the
# frontend polling with no error and no WebSocket. Making these effective
# requires the self-hosted installer (P-4) to pass them as Docker build
# arguments — tracked as a requirement there, not solved by this file alone.
# Once that wiring exists, these point at the public domain and port (the
# edge carries the WebSocket on 443 alongside normal traffic), not at the
# container.
#VITE_REVERB_APP_KEY=
#VITE_REVERB_HOST=example.com
#VITE_REVERB_PORT=443
#VITE_REVERB_SCHEME=https

# Mail. Under the default `log` mailer the contact portal's magic-link
# sign-in, email verification, invitations and CSAT requests all go nowhere.
# --mail=smtp fills MAIL_MAILER and the five keys below from the SMTP
# settings the installer collects. MAIL_SCHEME is Laravel's name for this
# (null|smtp|smtps) — MAIL_ENCRYPTION is not read anywhere in this app.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Prizy
# Set by --mail=smtp: null under --mail=log, smtp or smtps under --mail=smtp.
MAIL_SCHEME=
# Set by --mail=smtp.
MAIL_HOST=
# Set by --mail=smtp.
MAIL_PORT=
# Set by --mail=smtp. Empty when the SMTP server needs no authentication.
MAIL_USERNAME=
# Set by --mail=smtp. Empty when the SMTP server needs no authentication.
MAIL_PASSWORD=

# Search uses the database driver; no external service required.
SCOUT_DRIVER=database

# `single` never rotates or truncates: four roles (fpm, worker, scheduler,
# Reverb) share one storage volume, and any host that isn't the base domain
# or a workspace subdomain raises NoCurrentTenant and logs a multi-KB trace —
# so an internet scanner hitting the box by IP alone can fill the volume,
# and once it's full, all four roles fail together. `daily` rotates the file
# and prunes it after LOG_DAILY_DAYS days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
