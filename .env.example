APP_NAME=Prizy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_BASE_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=prizy
DB_USERNAME=prizy_app
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=prizy
REVERB_APP_KEY=prizy-key
REVERB_APP_SECRET=prizy-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Frontend (Vite) Reverb — browser-reachable. Real-time notifications are OFF by default
# (the app polls). Uncomment these AND run the Reverb server (docker `full` profile) to enable
# live push; the values must point at the browser-reachable Reverb, not the container hostname.
#VITE_REVERB_APP_KEY=prizy-key
#VITE_REVERB_HOST=localhost
#VITE_REVERB_PORT=8080
#VITE_REVERB_SCHEME=http

# --- Search (Laravel Scout). Dev/CI/tests use the `database` driver (SQL LIKE, no
# external service). Production uses Meilisearch (docker `full` profile): set
# SCOUT_DRIVER=meilisearch, MEILISEARCH_HOST/KEY, SCOUT_QUEUE=true, then run
# `php artisan scout:sync-index-settings` + `php artisan scout:import "App\Models\Issue"`.
SCOUT_DRIVER=database
#MEILISEARCH_HOST=http://meilisearch:7700
#MEILISEARCH_KEY=
#SCOUT_QUEUE=true
